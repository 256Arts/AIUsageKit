    "Orange: over 75% used." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Orange: über 75 % genutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Naranja: más del 75 % usado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Orange : plus de 75 % utilisés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オレンジ：75% 以上使用済み。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "橙色：已使用超过 75%。"
          }
        }
      }
    },
    "Orange: behind pace, so tokens will go unused when it resets." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Orange: langsamer als geplant, beim Zurücksetzen bleiben Tokens ungenutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Naranja: por detrás del ritmo, quedarán tokens sin usar al restablecerse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Orange : en retard sur le rythme, des jetons resteront inutilisés à la réinitialisation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オレンジ：ペースより遅く、リセット時にトークンが余ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "橙色：进度落后，重置时会有令牌未被使用。"
          }
        }
      }
    },
    "Orange: ahead of pace, so it may run out before it resets." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Orange: schneller als geplant, das Limit könnte vor dem Zurücksetzen aufgebraucht sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Naranja: por delante del ritmo, podría agotarse antes de restablecerse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Orange : en avance sur le rythme, la limite pourrait être atteinte avant sa réinitialisation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "オレンジ：ペースより早く、リセット前に使い切る可能性があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "橙色：进度超前，可能在重置前用完。"
          }
        }
      }
    },
