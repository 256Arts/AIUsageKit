    "Reads the sign-in your terminal is already using, at ~/%@. %@ keeps its own copy and never writes to the file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Liest die Anmeldung, die dein Terminal bereits verwendet, unter ~/%1$@. %2$@ behält eine eigene Kopie und schreibt nie in die Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lee el inicio de sesión que tu terminal ya está usando, en ~/%1$@. %2$@ guarda su propia copia y nunca escribe en el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lit la connexion déjà utilisée par votre terminal, à ~/%1$@. %2$@ conserve sa propre copie et n'écrit jamais dans le fichier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ターミナルが既に使用しているサインイン情報を ~/%1$@ から読み取ります。%2$@は独自のコピーを保持し、このファイルには書き込みません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "读取终端已在使用的登录信息，位于 ~/%1$@。%2$@ 会保留自己的副本，绝不会写入该文件。"
          }
        }
      }
    },
    "Sign In with %@" : {
      "localizations" : {
